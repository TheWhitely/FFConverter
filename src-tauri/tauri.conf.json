{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FFConverter",
  "version": "1.0.2",
  "identifier": "local.ffconverter",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:4173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "appDirectoriesOverride": "./data",
    "windows": [
      {
        "title": "FFConverter",
        "width": 1024,
        "height": 680,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#141414",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' media: http://media.localhost asset: http://asset.localhost data: blob:; media-src 'self' media: http://media.localhost asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
